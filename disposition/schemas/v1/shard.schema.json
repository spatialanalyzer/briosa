{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spatialanalyzer.github.io/briosa/disposition/schemas/v1/shard.schema.json",
  "title": "Briosa exact-target command disposition shard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "spatial_analyzer_target",
    "category",
    "entries"
  ],
  "properties": {
    "$schema": {
      "const": "../../../schemas/v1/shard.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "spatial_analyzer_target": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)+$"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/entry"
      }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "github_reference": {
      "type": "string",
      "pattern": "^https://github\\.com/spatialanalyzer/[A-Za-z0-9_.-]+/(?:issues|pull)/[1-9][0-9]*$"
    },
    "reference_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "github_reference_list": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/github_reference"
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_key",
        "mp_step",
        "category_path",
        "inventory_entry_sha256",
        "disposition",
        "review_state",
        "rationale",
        "reason_codes",
        "evidence_references",
        "decision_references",
        "blocker_references",
        "risk_effect",
        "risk_flags",
        "data_classifications",
        "value_families",
        "delivery_wave",
        "command_shape"
      ],
      "properties": {
        "inventory_key": {
          "type": "string",
          "minLength": 1
        },
        "mp_step": {
          "type": "string",
          "minLength": 1
        },
        "category_path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inventory_entry_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "disposition": {
          "enum": [
            "approved_candidate",
            "blocked",
            "intentional_exclusion",
            "sdk_unavailable"
          ]
        },
        "review_state": {
          "enum": [
            "needs_re_review",
            "reviewed",
            "unreviewed"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "evidence_references": {
          "$ref": "#/definitions/reference_list"
        },
        "decision_references": {
          "$ref": "#/definitions/github_reference_list"
        },
        "blocker_references": {
          "$ref": "#/definitions/github_reference_list"
        },
        "risk_effect": {
          "enum": [
            "read_only",
            "mutating",
            "unknown"
          ]
        },
        "risk_flags": {
          "type": "array",
          "items": {
            "enum": [
              "filesystem_metadata",
              "filesystem_read",
              "filesystem_write",
              "network_access",
              "external_process",
              "device_control",
              "interactive_ui",
              "long_running",
              "credential_or_license_data",
              "unknown"
            ]
          }
        },
        "data_classifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "credential",
              "geometry",
              "license_data",
              "measurement",
              "non_sensitive",
              "object_identifier",
              "path",
              "proprietary",
              "unknown"
            ]
          }
        },
        "value_families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "delivery_wave": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "wave_1",
                "wave_2",
                "wave_3",
                "wave_4",
                "final"
              ]
            }
          ]
        },
        "command_shape": {
          "$ref": "#/definitions/command_shape"
        }
      }
    },
    "command_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mp_step", "arguments", "discrepancies"],
      "properties": {
        "status": { "enum": ["resolved", "blocked", "not_applicable"] },
        "mp_step": { "type": ["string", "null"] },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/definitions/resolved_argument" }
        },
        "discrepancies": {
          "type": "array",
          "items": { "$ref": "#/definitions/discrepancy" }
        }
      }
    },
    "resolved_argument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_index", "ordinal", "mp_name", "direction", "result_only", "input", "sdk_binding"
      ],
      "properties": {
        "inventory_index": { "type": "integer", "minimum": 0 },
        "ordinal": { "type": "integer", "minimum": 0 },
        "mp_name": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["input", "output", "input_output"] },
        "result_only": { "enum": ["yes", "no"] },
        "input": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/input_resolution" }
          ]
        },
        "sdk_binding": { "$ref": "#/definitions/sdk_binding" }
      }
    },
    "input_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presence", "omission_behavior", "default"],
      "properties": {
        "presence": { "enum": ["required", "optional"] },
        "omission_behavior": {
          "enum": ["reject_request", "omit_sdk_setter", "set_catalog_default"]
        },
        "default": { "$ref": "#/definitions/default_resolution" }
      }
    },
    "default_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["none", "reviewed", "reviewed_no_default"] },
        "review_status": { "const": "needs_review" },
        "decision_reference": {
          "type": "string",
          "pattern": "^https://github\\.com/spatialanalyzer/briosa/issues/[0-9]+$"
        },
        "evidence_state": {
          "enum": ["exact_target_sample_only", "conflict", "objectivesa_only"]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "value": {},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["objectivesa_prior_release", "sa_2026_generated_vb"]
          }
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/default_candidate" }
        }
      }
    },
    "default_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "value"],
      "properties": {
        "source": {
          "enum": ["objectivesa_prior_release", "sa_2026_generated_vb"]
        },
        "value": {}
      }
    },
    "sdk_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setter", "getter"],
      "properties": {
        "setter": {
          "type": ["string", "null"],
          "pattern": "^Set[A-Za-z0-9]+Arg[0-9]*$"
        },
        "getter": {
          "type": ["string", "null"],
          "pattern": "^Get[A-Za-z0-9]+Arg[0-9]*$"
        }
      }
    },
    "discrepancy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "argument_indexes", "owner", "blocker_reference", "rationale"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "argument_indexes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "owner": { "enum": ["briosa", "hexagon"] },
        "blocker_reference": { "$ref": "#/definitions/github_reference" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
