{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spatialanalyzer.github.io/briosa/release/schemas/v1/audit-policy.schema.json",
  "title": "Briosa exact-target release audit policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "spatial_analyzer_target",
    "master_epic",
    "protected_conformance",
    "runtime_identity_validation",
    "operator_guide_paths"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/v1/audit-policy.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "spatial_analyzer_target": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)+$"
    },
    "master_epic": {
      "const": "https://github.com/spatialanalyzer/briosa/issues/47"
    },
    "protected_conformance": {
      "$ref": "#/definitions/pending_evidence"
    },
    "runtime_identity_validation": {
      "$ref": "#/definitions/pending_evidence"
    },
    "operator_guide_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^docs/[A-Za-z0-9_./-]+\\.md$"
      }
    }
  },
  "definitions": {
    "pending_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "blocker_references"
      ],
      "properties": {
        "status": {
          "const": "pending"
        },
        "blocker_references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://github\\.com/spatialanalyzer/briosa/issues/[1-9][0-9]*$"
          }
        }
      }
    }
  }
}
