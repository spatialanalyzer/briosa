{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spatialanalyzer.github.io/briosa/release/schemas/v1/support-matrix.schema.json",
  "title": "Briosa exact-target support matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "generated_by",
    "spatial_analyzer_target",
    "evidence_inputs",
    "counts",
    "commands"
  ],
  "properties": {
    "$schema": {
      "const": "../../../../release/schemas/v1/support-matrix.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "generated_by": {
      "const": "Briosa.Generator release evidence"
    },
    "spatial_analyzer_target": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)+$"
    },
    "evidence_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/evidence"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_commands",
        "cataloged_operations",
        "approved_candidates",
        "approved_not_cataloged",
        "blocked",
        "intentional_exclusions",
        "sdk_unavailable",
        "portable_validated_cataloged_operations",
        "protected_validated_cataloged_operations"
      ],
      "properties": {
        "inventory_commands": {
          "type": "integer",
          "minimum": 0
        },
        "cataloged_operations": {
          "type": "integer",
          "minimum": 0
        },
        "approved_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "approved_not_cataloged": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "intentional_exclusions": {
          "type": "integer",
          "minimum": 0
        },
        "sdk_unavailable": {
          "type": "integer",
          "minimum": 0
        },
        "portable_validated_cataloged_operations": {
          "type": "integer",
          "minimum": 0
        },
        "protected_validated_cataloged_operations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/command"
      }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_key",
        "mp_step",
        "category_path",
        "disposition",
        "review_state",
        "release_classification",
        "operation_id",
        "risk_effect",
        "risk_flags",
        "replay_safety",
        "execution_scope",
        "prerequisites",
        "validation",
        "blocker_references"
      ],
      "properties": {
        "inventory_key": {
          "type": "string",
          "minLength": 1
        },
        "mp_step": {
          "type": "string",
          "minLength": 1
        },
        "category_path": {
          "$ref": "#/definitions/string_list"
        },
        "disposition": {
          "enum": [
            "approved_candidate",
            "blocked",
            "intentional_exclusion",
            "sdk_unavailable"
          ]
        },
        "review_state": {
          "const": "reviewed"
        },
        "release_classification": {
          "enum": [
            "cataloged_portable_only",
            "approved_not_cataloged",
            "blocked",
            "intentional_exclusion",
            "sdk_unavailable"
          ]
        },
        "operation_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        },
        "risk_effect": {
          "enum": [
            "read_only",
            "mutating",
            "unknown"
          ]
        },
        "risk_flags": {
          "$ref": "#/definitions/string_list"
        },
        "replay_safety": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "safe",
            "unsafe",
            "unknown",
            null
          ]
        },
        "execution_scope": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "self_contained",
            "global_state_read",
            "global_state_mutation",
            "exclusive_workflow",
            "unknown",
            null
          ]
        },
        "prerequisites": {
          "$ref": "#/definitions/string_list"
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metadata",
            "portable",
            "protected_spatial_analyzer"
          ],
          "properties": {
            "metadata": {
              "const": "reviewed_metadata"
            },
            "portable": {
              "enum": [
                "portable_briosa_contract",
                "not_applicable"
              ]
            },
            "protected_spatial_analyzer": {
              "enum": [
                "not_performed",
                "not_applicable"
              ]
            }
          }
        },
        "blocker_references": {
          "$ref": "#/definitions/string_list"
        }
      }
    }
  }
}
