{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spatialanalyzer.github.io/briosa/release/schemas/v1/release-audit.schema.json",
  "title": "Briosa exact-target release audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "generated_by",
    "spatial_analyzer_target",
    "master_epic",
    "release_ready",
    "evidence_inputs",
    "summary",
    "criteria"
  ],
  "properties": {
    "$schema": {
      "const": "../../../../release/schemas/v1/release-audit.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "generated_by": {
      "const": "Briosa.Generator release evidence"
    },
    "spatial_analyzer_target": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)+$"
    },
    "master_epic": {
      "const": "https://github.com/spatialanalyzer/briosa/issues/47"
    },
    "release_ready": {
      "type": "boolean"
    },
    "evidence_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/evidence"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "blocked",
        "not_applicable"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/definitions/criterion"
      }
    }
  },
  "definitions": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "source",
        "description",
        "status",
        "evidence",
        "blocker_references"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "source": {
          "type": "string",
          "pattern": "^https://github\\.com/spatialanalyzer/briosa/issues/[1-9][0-9]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "blocked",
            "not_applicable"
          ]
        },
        "evidence": {
          "$ref": "#/definitions/string_list"
        },
        "blocker_references": {
          "$ref": "#/definitions/string_list"
        }
      }
    }
  }
}
