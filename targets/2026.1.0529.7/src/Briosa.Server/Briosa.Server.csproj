<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Prefer32Bit>false</Prefer32Bit>
    <Description>Public gRPC host for Briosa.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);BRIOSA_DEVELOPMENT_REFLECTION</DefineConstants>
    <UserSecretsId>spatialanalyzer-briosa-development</UserSecretsId>
    <BriosaDevelopmentWorkerOutput>$(MSBuildProjectDirectory)\..\Briosa.Worker\bin\$(Configuration)\$(TargetFramework)\</BriosaDevelopmentWorkerOutput>
  </PropertyGroup>

  <ItemGroup Condition="'$(SourceRevisionId)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryCommit</_Parameter1>
      <_Parameter2>$(SourceRevisionId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" />
    <ProjectReference Include="..\Briosa.Protocol\Briosa.Protocol.csproj" />
    <ProjectReference Include="..\Briosa.Worker.Control\Briosa.Worker.Control.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\Briosa.Worker\Briosa.Worker.csproj"
                      ReferenceOutputAssembly="false" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" />
  </ItemGroup>

  <Target Name="CopyDevelopmentWorkerCohort"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <_BriosaDevelopmentWorkerFiles Include="$(BriosaDevelopmentWorkerOutput)**\*" />
      <_BriosaDevelopmentWorkerSettings Include="$(BriosaDevelopmentWorkerOutput)**\appsettings*.json" />
    </ItemGroup>
    <Error Condition="!Exists('$(BriosaDevelopmentWorkerOutput)Briosa.Worker.exe')"
           Text="The Debug Briosa.Worker build output is unavailable for source-host composition." />
    <Error Condition="'@(_BriosaDevelopmentWorkerSettings)' != ''"
           Text="Worker appsettings files require explicit review before Debug source-host composition." />
    <Copy SourceFiles="@(_BriosaDevelopmentWorkerFiles)"
          DestinationFiles="@(_BriosaDevelopmentWorkerFiles->'$(TargetDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ExcludeDevelopmentReflectionFromRelease"
          AfterTargets="ResolvePackageAssets"
          Condition="'$(Configuration)' != 'Debug'">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
          Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'Grpc.AspNetCore.Server.Reflection' Or '%(ReferenceCopyLocalPaths.Filename)' == 'Grpc.Reflection'" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)"
          Condition="'%(RuntimeCopyLocalItems.Filename)' == 'Grpc.AspNetCore.Server.Reflection' Or '%(RuntimeCopyLocalItems.Filename)' == 'Grpc.Reflection'" />
    </ItemGroup>
  </Target>
  <Target Name="ExcludeDevelopmentReflectionFromReleasePublish"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(Configuration)' != 'Debug'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Filename)' == 'Grpc.AspNetCore.Server.Reflection' Or '%(ResolvedFileToPublish.Filename)' == 'Grpc.Reflection'" />
    </ItemGroup>
  </Target>
</Project>
