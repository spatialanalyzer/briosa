<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Briosa.ControlCenter.App</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationIcon>Assets/AppIcon/briosa.ico</ApplicationIcon>
    <Description>Windows tray and status controller for one exact-target Briosa server.</Description>
    <!-- WPF continuations retain the dispatcher; XAML-generated types are public.
         The initial desktop product has an explicitly English UI. -->
    <NoWarn>$(NoWarn);CA2007;CA1515;CA1303</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Briosa.Desktop/Briosa.Desktop.csproj" />
    <Resource Include="Assets/AppIcon/briosa.ico" />
    <Resource Include="Assets/Brand/png/logos/*.png" />
    <Resource Include="Assets/Brand/fonts/Inter-Variable.ttf" />
  </ItemGroup>
</Project>
