<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- The source-generated Win32 calls for handle-bound result files (Engine/NativeMethods.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Attach-only JSON command line that inspects SpatialAnalyzer through a local Briosa server.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The CLI is published into the server's package directory. Resolving the
         Microsoft.Extensions assemblies from the same ASP.NET Core runtime pack as
         the server keeps every shared file byte-identical; see docs/operations/briosa-cli.md. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.Net.Client" />
    <!-- Shared with the server, worker and launcher in the package directory; see Directory.Packages.props. -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <ProjectReference Include="..\Briosa.Protocol\Briosa.Protocol.csproj" />
  </ItemGroup>
</Project>
