{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Grpc": "Warning"
    }
  },
  "Briosa": {
    "Logging": {
      "ConsoleEnabled": true,
      "QueueCapacity": 4096,
      "ShutdownTimeoutMilliseconds": 2000,
      "File": {
        "Enabled": true,
        "MaxFileSizeMiB": 20,
        "RetainedFileCount": 10,
        "MaxAgeDays": 7,
        "MaxTotalSizeMiB": 200
      }
    },
    "Telemetry": {
      "Enabled": false,
      "SampleRatio": 0.1
    },
    "Endpoint": {
      "Address": "127.0.0.1",
      "Port": 50051
    },
    "Security": {
      "Operations": {
        "Profile": "standard"
      }
    },
    "SpatialAnalyzer": {
      "Host": "localhost"
    },
    "Worker": {
      "ExecutionWatchdogTimeout": "00:00:30",
      "MaxRetainedWorkMiB": 32
    }
  }
}
