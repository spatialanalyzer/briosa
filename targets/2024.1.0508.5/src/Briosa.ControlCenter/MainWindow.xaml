<Window x:Class="Briosa.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Briosa Control Center" Width="1140" Height="800" MinWidth="820" MinHeight="600" Style="{StaticResource {x:Type Window}}"
        Icon="Assets/AppIcon/briosa.ico" WindowStartupLocation="CenterScreen"
        Closing="WindowClosing" SizeChanged="WindowSizeChanged">
  <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="208" /><ColumnDefinition /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource BriosaNavigationBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,1,0" TextElement.Foreground="{DynamicResource BriosaNavigationTextBrush}">
      <DockPanel Margin="16,26,16,20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,26">
          <Image x:Name="BrandImage" Source="{DynamicResource BriosaLogo}" Width="160" Stretch="Uniform" AutomationProperties.Name="Briosa" />
          <TextBlock Text="Control Center" Margin="12,6,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="12,20,0,0"><TextBlock Text="Briosa server" FontSize="12" /><TextBlock Text="SA 2024.1.0508.5" FontSize="11" Margin="0,4,0,0" /></StackPanel>
        <ListBox x:Name="Navigation" SelectedIndex="0" SelectionChanged="NavigationChanged" ItemContainerStyle="{StaticResource NavigationItem}" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" AutomationProperties.Name="Control Center navigation">
          <ListBox.Resources>
            <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="{DynamicResource BriosaNavigationSelectedColor}" />
            <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush" Color="{DynamicResource BriosaNavigationSelectedHoverColor}" />
            <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="{DynamicResource BriosaNavigationSelectedTextColor}" />
            <SolidColorBrush x:Key="ListBoxItemUnselectedBackgroundPointerOverThemeBrush" Color="{DynamicResource BriosaNavigationHoverColor}" />
          </ListBox.Resources>
          <ListBoxItem Content="Overview" /><ListBoxItem Content="Activity" /><ListBoxItem Content="Details &amp; support" /><ListBoxItem Content="Connection setup" />
        </ListBox>
      </DockPanel>
    </Border>
    <Border Grid.Column="1" Background="{DynamicResource BriosaWorkspaceBrush}" IsHitTestVisible="False" Focusable="False" />
    <Grid Grid.Column="1" Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20">
      <Button DockPanel.Dock="Right" Content="_Refresh" Click="RefreshClicked" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding SelectedItem.Content, ElementName=Navigation}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource BriosaHeadingBrush}" />
        <TextBlock Text="SpatialAnalyzer 2024.1.0508.5 · local Windows server" Margin="0,4,0,0" />
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource BriosaSelectionBorderBrush}" BorderThickness="4,0,0,0" Padding="16,12" CornerRadius="4" Margin="0,0,0,20">
      <StackPanel>
        <TextBlock x:Name="HeadingText" Text="Server stopped" FontSize="24" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="GuidanceText" Margin="0,7,0,0" />
        <TextBlock x:Name="IncidentText" Margin="0,7,0,0" FontWeight="SemiBold" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="2">
      <Grid.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style></Grid.Resources>
      <Grid x:Name="OverviewPage">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,8,0,0">
            <TextBlock x:Name="OwnershipText" Margin="0,0,0,14" />
            <Grid x:Name="OverviewCards">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatusCard}"><StackPanel>
                <TextBlock Text="API server" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="HostText" />
                <TextBlock x:Name="EndpointText" Margin="0,6,0,10" />
                <WrapPanel><Button x:Name="StartButton" Content="_Start server" Click="StartClicked" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" /><Button x:Name="StopButton" Content="S_top server" Click="StopClicked" /><Button x:Name="RestartButton" Content="_Restart server" Click="RestartClicked" /></WrapPanel>
              </StackPanel></Border>
              <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatusCard}"><StackPanel>
                <TextBlock Text="SpatialAnalyzer" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="ApplicationText" />
                <TextBlock Text="Open SpatialAnalyzer separately. Stopping Briosa leaves it open." Margin="0,10,0,0" />
              </StackPanel></Border>
              <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StatusCard}"><StackPanel>
                <TextBlock Text="SDK connection" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="SdkText" />
                <WrapPanel Margin="0,12,0,0"><Button x:Name="StartSdkButton" Content="Start S_DK" Click="StartSdkClicked" /><Button x:Name="ConnectButton" Content="_Connect" Click="ConnectClicked" /><Button x:Name="ReconnectButton" Content="Reconnect" Click="ReconnectClicked" /><Button x:Name="StopSdkButton" Content="Stop SDK" Click="StopSdkClicked" /><Button x:Name="RecoverButton" Content="Recover SDK" Click="RecoverClicked" /></WrapPanel>
              </StackPanel></Border>
              <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatusCard}"><StackPanel>
                <TextBlock Text="Version identity &amp; readiness" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="IdentityText" />
                <Button Content="Connection setup" Click="SetupClicked" HorizontalAlignment="Left" Margin="0,12,0,0" />
              </StackPanel></Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="ActivityPage" Visibility="Collapsed">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <CheckBox x:Name="PauseActivity" Content="Pause updates" VerticalAlignment="Center" Margin="0,0,14,0" />
            <ComboBox x:Name="SeverityFilter" Width="130" SelectedIndex="0" SelectionChanged="FilterChanged" Margin="0,0,14,0" AutomationProperties.Name="Activity severity">
              <ComboBoxItem Content="All levels" /><ComboBoxItem Content="Warnings &amp; errors" /><ComboBoxItem Content="Errors" />
            </ComboBox>
            <TextBox x:Name="SearchBox" TextChanged="FilterChanged" Padding="6" AutomationProperties.Name="Search activity" ToolTip="Search events, operations, diagnostic codes, and correlation IDs" />
          </DockPanel>
          <DataGrid x:Name="ActivityGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionMode="Extended" ClipboardCopyMode="IncludeHeader" AutomationProperties.Name="Recent server activity">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="76" />
              <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90" />
              <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" />
              <DataGridTextColumn Header="Event" Binding="{Binding Message}" Width="360" />
              <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="200" />
              <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="400" />
              <DataGridTextColumn Header="Correlation" Binding="{Binding Correlation}" Width="280" />
            </DataGrid.Columns>
          </DataGrid>
          <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="Jump to latest" Click="LatestClicked" /><TextBlock x:Name="ActivityStatus" VerticalAlignment="Center" /></DockPanel>
        </Grid>
      </Grid>
      <Grid x:Name="DetailsPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="This distribution" Style="{StaticResource SectionTitle}" />
          <TextBox x:Name="VersionText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,0,0,20" AutomationProperties.Name="Distribution and runtime details" />
          <WrapPanel><Button Content="Copy endpoint" Click="CopyEndpointClicked" /><Button Content="Run package diagnostics" Click="DiagnosticsClicked" /><Button Content="Export support information…" Click="ExportClicked" /></WrapPanel>
          <TextBlock Text="Support exports contain safe version and lifecycle information plus curated recent activity. They exclude endpoint addresses, local paths, credentials, raw exceptions, and SpatialAnalyzer command inputs and outputs." Margin="0,6,0,20" />
          <TextBlock Text="Preferences" Style="{StaticResource SectionTitle}" />
          <Label Content="App _theme" Target="{Binding ElementName=ThemeSelector}" />
          <ComboBox x:Name="ThemeSelector" SelectedIndex="0" SelectionChanged="ThemeChanged" Width="220" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.Name="App theme">
            <ComboBoxItem Content="Use Windows setting" /><ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" />
          </ComboBox>
          <CheckBox x:Name="NotificationsBox" Content="Notify me when attention is required" Checked="NotificationsChanged" Unchecked="NotificationsChanged" />
          <TextBlock Text="Closing this window hides it to the tray. Exit tray application leaves a running server available. Updates and removal are managed through the Briosa installer." Margin="0,20,0,0" />
        </StackPanel></Border></ScrollViewer>
      </Grid>
      <Grid x:Name="SetupPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="Version evidence" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="Briosa reads the activated SDK executable version. The connected SA version still requires independent operator evidence. Verify the actual running application; an installed package alone is insufficient. Runtime evidence takes precedence over entries below." Margin="0,0,0,12" />
          <TextBlock x:Name="SetupStatus" Margin="0,0,0,12" FontWeight="SemiBold" />
          <StackPanel x:Name="IdentityFields">
            <TextBlock Text="Connected SpatialAnalyzer" Style="{StaticResource SectionTitle}" />
            <Label Content="SA _version" Target="{Binding ElementName=ApplicationVersionBox}" />
            <TextBox x:Name="ApplicationVersionBox" MaxLength="96" AutomationProperties.Name="Connected SA version" />
            <Label Content="SA evidence _reference" Target="{Binding ElementName=ApplicationReferenceBox}" />
            <TextBox x:Name="ApplicationReferenceBox" MaxLength="256" AutomationProperties.Name="Connected SA evidence reference" />
            <TextBlock Text="Use a non-sensitive reference to your verification record. Verify the SDK communication owner when several SA instances are running." Margin="0,8,0,20" />
            <Expander Header="Activated SDK fallback · optional" Margin="0,0,0,4"><StackPanel Margin="0,12,0,0">
            <TextBlock Text="Leave both fields empty when the SDK version is observed automatically. These fields cannot override an observed mismatch." />
            <Label Content="SDK v_ersion" Target="{Binding ElementName=SdkVersionBox}" />
            <TextBox x:Name="SdkVersionBox" MaxLength="96" AutomationProperties.Name="Activated SDK version" />
            <Label Content="SDK evidence re_ference" Target="{Binding ElementName=SdkReferenceBox}" />
            <TextBox x:Name="SdkReferenceBox" MaxLength="256" AutomationProperties.Name="Activated SDK evidence reference" />
            </StackPanel></Expander>
            <Button x:Name="SaveSetupButton" Content="Save connection setup" Click="SaveSetupClicked" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,20,0,12" />
          </StackPanel>
          <TextBlock Text="Saved privately for this distribution and applied to future servers launched by this Control Center. Recheck evidence after changing SDK registration or the SA application. Empty pairs use existing server configuration. Evidence references are excluded from logs and support exports." />
        </StackPanel></Border></ScrollViewer>
      </Grid>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,16,0,0">
      <Button Content="Exit tray application" Click="ExitClicked" DockPanel.Dock="Right" Margin="12,0,0,0" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="ObservedText" Text="No server observation yet." />
        <TextBlock x:Name="ActionText" Margin="0,4,0,0" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </DockPanel>
    </Grid>
  </Grid>
</Window>
