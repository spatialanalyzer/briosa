{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spatialanalyzer.github.io/briosa/catalog/schemas/v1/scaffold-manifest.schema.json",
  "title": "Briosa exact-target catalog review-scaffold manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "spatial_analyzer_target",
    "source_fingerprints",
    "approved_candidate_count",
    "existing_catalog_operation_count",
    "scaffold_count",
    "scaffold_files"
  ],
  "properties": {
    "$schema": {
      "const": "https://spatialanalyzer.github.io/briosa/catalog/schemas/v1/scaffold-manifest.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "spatial_analyzer_target": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)+$"
    },
    "source_fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_sha256",
        "disposition_manifest_sha256",
        "value_family_catalog_sha256",
        "supported_catalog_manifest_sha256"
      ],
      "properties": {
        "inventory_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "disposition_manifest_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "value_family_catalog_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "supported_catalog_manifest_sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "approved_candidate_count": {
      "type": "integer",
      "minimum": 1
    },
    "existing_catalog_operation_count": {
      "type": "integer",
      "minimum": 0
    },
    "scaffold_count": {
      "type": "integer",
      "minimum": 0
    },
    "scaffold_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "inventory_key",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^candidates/[a-f0-9]{64}\\.json$"
          },
          "inventory_key": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/definitions/sha256"
          }
        }
      }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
