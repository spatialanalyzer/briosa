{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spatialanalyzer.github.io/briosa/catalog/schemas/v1/scaffold.schema.json",
  "title": "Briosa incomplete exact-target catalog review scaffold",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "spatial_analyzer_target",
    "inventory_key",
    "inventory_mp_step",
    "resolved_mp_step",
    "category_path",
    "delivery_wave",
    "source_fingerprints",
    "evidence_references",
    "decision_references",
    "reviewed_disposition",
    "catalog_draft",
    "arguments",
    "review_status",
    "blockers"
  ],
  "properties": {
    "$schema": {
      "const": "https://spatialanalyzer.github.io/briosa/catalog/schemas/v1/scaffold.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "spatial_analyzer_target": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)+$"
    },
    "inventory_key": {
      "type": "string",
      "minLength": 1
    },
    "inventory_mp_step": {
      "type": "string",
      "minLength": 1
    },
    "resolved_mp_step": {
      "type": "string",
      "minLength": 1
    },
    "category_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "delivery_wave": {
      "enum": [
        "final",
        "wave_1",
        "wave_2",
        "wave_3",
        "wave_4"
      ]
    },
    "source_fingerprints": {
      "$ref": "#/definitions/source_fingerprints"
    },
    "evidence_references": {
      "$ref": "#/definitions/non_empty_string_array"
    },
    "decision_references": {
      "$ref": "#/definitions/non_empty_string_array"
    },
    "reviewed_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_effect",
        "risk_flags",
        "data_classifications",
        "value_families"
      ],
      "properties": {
        "risk_effect": {
          "enum": [
            "mutating",
            "read_only"
          ]
        },
        "risk_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data_classifications": {
          "$ref": "#/definitions/non_empty_string_array"
        },
        "value_families": {
          "$ref": "#/definitions/non_empty_string_array"
        }
      }
    },
    "catalog_draft": {
      "$ref": "#/definitions/catalog_draft"
    },
    "arguments": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/argument"
      }
    },
    "review_status": {
      "const": "incomplete"
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/"
      }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_sha256",
        "inventory_entry_sha256",
        "disposition_manifest_sha256",
        "disposition_shard_path",
        "disposition_shard_sha256",
        "value_family_catalog_sha256",
        "supported_catalog_manifest_sha256"
      ],
      "properties": {
        "inventory_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "inventory_entry_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "disposition_manifest_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "disposition_shard_path": {
          "type": "string",
          "pattern": "^categories/[a-z][a-z0-9_]*\\.json$"
        },
        "disposition_shard_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "value_family_catalog_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "supported_catalog_manifest_sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "catalog_draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mp_step",
        "operation_id",
        "category",
        "protocol",
        "stability",
        "execution_scope",
        "risk",
        "documentation",
        "evidence"
      ],
      "properties": {
        "mp_step": {
          "type": "string",
          "minLength": 1
        },
        "operation_id": {
          "type": "null"
        },
        "category": {
          "type": "null"
        },
        "protocol": {
          "type": "null"
        },
        "stability": {
          "type": "null"
        },
        "execution_scope": {
          "type": "null"
        },
        "risk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effect",
            "replay_safety",
            "flags"
          ],
          "properties": {
            "effect": {
              "type": "null"
            },
            "replay_safety": {
              "type": "null"
            },
            "flags": {
              "type": "null"
            }
          }
        },
        "documentation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "isolation"
          ],
          "properties": {
            "summary": {
              "type": "null"
            },
            "isolation": {
              "type": "null"
            }
          }
        },
        "evidence": {
          "type": "null"
        }
      }
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_index",
        "ordinal",
        "sdk_order",
        "mp_name",
        "direction",
        "result_only",
        "semantic_type",
        "public_type_target",
        "worker_type_target",
        "family_assignments",
        "reviewed_input",
        "sdk_binding",
        "catalog_fields"
      ],
      "properties": {
        "inventory_index": {
          "type": "integer",
          "minimum": 0
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "sdk_order": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "mp_name": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "input",
            "output",
            "input_output"
          ]
        },
        "result_only": {
          "enum": [
            "yes",
            "no"
          ]
        },
        "semantic_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "public_type_target": {
          "type": "string",
          "minLength": 1
        },
        "worker_type_target": {
          "type": "string",
          "minLength": 1
        },
        "family_assignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "source",
              "sdk_order",
              "documented_ordinals"
            ],
            "properties": {
              "method": {
                "type": "string",
                "pattern": "^(?:Get|Set)[A-Za-z0-9]+Arg[0-9]*$"
              },
              "source": {
                "enum": [
                  "binding_method",
                  "exact_command_assignment"
                ]
              },
              "sdk_order": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "documented_ordinals": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "reviewed_input": {
          "oneOf": [
            {
              "$ref": "#/definitions/reviewed_input"
            },
            {
              "type": "null"
            }
          ]
        },
        "sdk_binding": {
          "$ref": "#/definitions/sdk_binding"
        },
        "catalog_fields": {
          "$ref": "#/definitions/catalog_fields"
        }
      }
    },
    "reviewed_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presence",
        "omission_behavior",
        "default"
      ],
      "properties": {
        "presence": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "omission_behavior": {
          "enum": [
            "reject_request",
            "omit_sdk_setter",
            "set_catalog_default"
          ]
        },
        "default": {
          "$ref": "#/definitions/reviewed_default"
        }
      }
    },
    "reviewed_default": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "none",
            "reviewed",
            "reviewed_no_default"
          ]
        },
        "review_status": {
          "type": "string"
        },
        "decision_reference": {
          "type": "string"
        },
        "evidence_state": {
          "type": "string"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "value": {},
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "value"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "value": {}
            }
          }
        }
      }
    },
    "sdk_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setter",
        "getter"
      ],
      "properties": {
        "setter": {
          "type": [
            "string",
            "null"
          ]
        },
        "getter": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "catalog_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argument_id",
        "data_classification",
        "input",
        "documentation"
      ],
      "properties": {
        "argument_id": {
          "type": "null"
        },
        "data_classification": {
          "type": "null"
        },
        "input": {
          "type": "null"
        },
        "documentation": {
          "type": "null"
        }
      }
    }
  }
}
