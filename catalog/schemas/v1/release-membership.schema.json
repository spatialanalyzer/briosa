{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spatialanalyzer.github.io/briosa/catalog/schemas/v1/release-membership.schema.json",
  "title": "Briosa exact-target release subset membership",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "membership_id",
    "release_line",
    "delivery_wave",
    "catalog_id",
    "spatial_analyzer_target",
    "catalog_revision",
    "operation_ids"
  ],
  "properties": {
    "$schema": {
      "const": "../../../schemas/v1/release-membership.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "membership_id": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+-[a-z][a-z0-9-]*$"
    },
    "release_line": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+$"
    },
    "delivery_wave": {
      "enum": [
        "wave_1",
        "wave_2",
        "wave_3",
        "wave_4",
        "final"
      ]
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^briosa\\.sa\\.[0-9]+(?:\\.[0-9]+)+$"
    },
    "spatial_analyzer_target": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)+$"
    },
    "catalog_revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "operation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
      }
    }
  }
}
