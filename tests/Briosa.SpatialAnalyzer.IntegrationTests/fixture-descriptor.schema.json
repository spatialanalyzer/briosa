{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spatialanalyzer.github.io/briosa/schemas/file-operation-fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "job_path": { "type": "string", "minLength": 1 },
    "input_path": { "type": "string", "minLength": 1 },
    "object": { "$ref": "#/$defs/object_reference" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/object_reference" }
    }
  },
  "$defs": {
    "object_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "collection_name": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      }
    }
  }
}
