{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spatialanalyzer.github.io/briosa/schemas/file-operation-matrix.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "spatial_analyzer_target",
    "objectivesa_commit",
    "scenarios"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "spatial_analyzer_target": { "const": "2026.1.0529.7" },
    "objectivesa_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "scenarios": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inventory_key",
          "mp_step",
          "scenario",
          "objectivesa_method",
          "fixture_status",
          "validation_status"
        ],
        "properties": {
          "inventory_key": { "type": "string", "minLength": 1 },
          "mp_step": { "type": "string", "minLength": 1 },
          "scenario": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "objectivesa_method": { "type": "string", "pattern": "^ObjectiveSAClient\\.[A-Za-z0-9]+$" },
          "fixture_status": {
            "enum": [
              "exact_target_xml_and_point_group_fixture_required",
              "exact_target_xml_fixture_required",
              "generated_by_test",
              "generated_wrong_type_by_test",
              "licensed_third_party_fixture_required",
              "local_event_reference_list_required"
            ]
          },
          "validation_status": {
            "enum": [
              "no_valid_fixture",
              "not_performed",
              "performed_successfully",
              "wrong_type_rejected"
            ]
          }
        }
      }
    }
  }
}
