{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spatialanalyzer.github.io/briosa/conformance/schemas/v1/live-scenarios.schema.json",
  "title": "Briosa packaged-host client conformance scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "fixture_set_id",
    "operation_id",
    "error_trailer",
    "scenarios"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/v1/live-scenarios.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "fixture_set_id": {
      "const": "briosa.client.live.v1"
    },
    "operation_id": {
      "const": "file_operations.get_working_directory"
    },
    "error_trailer": {
      "const": "briosa-operation-error-bin"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/scenario"
      }
    }
  },
  "definitions": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "worker_scenario",
        "watchdog_timeout",
        "deny_operation",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "worker_scenario": {
          "enum": [
            "ready",
            "disconnected",
            "mp-failure",
            "output-failure",
            "delay-first-execute",
            "hang-first-execute"
          ]
        },
        "watchdog_timeout": {
          "type": [
            "string",
            "null"
          ]
        },
        "deny_operation": {
          "type": "boolean"
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grpc_status",
            "ready_for_mp",
            "operation_advertised",
            "operation_succeeded",
            "recovery_succeeded",
            "typed_error_required",
            "failure_kinds"
          ],
          "properties": {
            "grpc_status": {
              "type": "string",
              "minLength": 1
            },
            "ready_for_mp": {
              "type": "boolean"
            },
            "operation_advertised": {
              "type": "boolean"
            },
            "operation_succeeded": {
              "type": "boolean"
            },
            "recovery_succeeded": {
              "type": "boolean"
            },
            "typed_error_required": {
              "type": "boolean"
            },
            "failure_kinds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^OPERATION_FAILURE_KIND_[A-Z0-9_]+$"
              }
            }
          }
        }
      }
    }
  }
}
