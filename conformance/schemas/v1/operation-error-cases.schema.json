{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spatialanalyzer.github.io/briosa/conformance/schemas/v1/operation-error-cases.schema.json",
  "title": "Briosa typed operation error conformance cases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "fixture_set_id",
    "error_trailer",
    "cases"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/v1/operation-error-cases.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "fixture_set_id": {
      "const": "briosa.client.operation-errors.v1"
    },
    "error_trailer": {
      "const": "briosa-operation-error-bin"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/case"
      }
    }
  },
  "definitions": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "grpc_status",
        "operation_error",
        "client_behavior"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "grpc_status": {
          "type": "string",
          "minLength": 1
        },
        "operation_error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_id",
            "kind",
            "diagnostic_code",
            "execution_disposition",
            "recovery_guidance",
            "replay_guidance",
            "replay_safety",
            "mp_execution"
          ],
          "properties": {
            "operation_id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "pattern": "^OPERATION_FAILURE_KIND_[A-Z0-9_]+$"
            },
            "diagnostic_code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "execution_disposition": {
              "type": "string",
              "pattern": "^EXECUTION_DISPOSITION_[A-Z0-9_]+$"
            },
            "recovery_guidance": {
              "type": "string",
              "pattern": "^RECOVERY_GUIDANCE_[A-Z0-9_]+$"
            },
            "replay_guidance": {
              "type": "string",
              "pattern": "^REPLAY_GUIDANCE_[A-Z0-9_]+$"
            },
            "replay_safety": {
              "type": "string",
              "pattern": "^REPLAY_SAFETY_[A-Z0-9_]+$"
            },
            "mp_execution": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        },
        "client_behavior": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "automatic_replay",
            "wait_for_readiness",
            "reconciliation_required"
          ],
          "properties": {
            "automatic_replay": {
              "const": false
            },
            "wait_for_readiness": {
              "type": "boolean"
            },
            "reconciliation_required": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
