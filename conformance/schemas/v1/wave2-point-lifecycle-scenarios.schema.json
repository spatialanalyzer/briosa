{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spatialanalyzer.github.io/briosa/conformance/schemas/v1/wave2-point-lifecycle-scenarios.schema.json",
  "title": "Briosa Wave 2 point-lifecycle generated-client scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "fixture_set_id",
    "error_trailer",
    "scenarios"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/v1/wave2-point-lifecycle-scenarios.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "fixture_set_id": {
      "const": "briosa.client.wave2-point-lifecycle.v1"
    },
    "error_trailer": {
      "const": "briosa-operation-error-bin"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/scenario"
      }
    }
  },
  "definitions": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation_id",
        "worker_scenario",
        "watchdog_timeout",
        "deny_operation",
        "expected"
      ],
      "properties": {
        "id": {
          "enum": [
            "construct-point-missing-coordinates",
            "construct-point-ready",
            "delete-points-policy-denied",
            "rename-point-mp-failure"
          ]
        },
        "operation_id": {
          "enum": [
            "collection_operations.construct_point_in_working_coordinates",
            "collection_operations.delete_points",
            "collection_operations.rename_point"
          ]
        },
        "worker_scenario": {
          "enum": [
            "ready",
            "mp-failure"
          ]
        },
        "watchdog_timeout": {
          "type": [
            "string",
            "null"
          ]
        },
        "deny_operation": {
          "type": "boolean"
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grpc_status",
            "ready_for_mp",
            "operation_advertised",
            "operation_succeeded",
            "recovery_succeeded",
            "typed_error_required",
            "failure_kinds"
          ],
          "properties": {
            "grpc_status": {
              "enum": [
                "FAILED_PRECONDITION",
                "INVALID_ARGUMENT",
                "OK",
                "PERMISSION_DENIED"
              ]
            },
            "ready_for_mp": {
              "type": "boolean"
            },
            "operation_advertised": {
              "type": "boolean"
            },
            "operation_succeeded": {
              "type": "boolean"
            },
            "recovery_succeeded": {
              "type": "boolean"
            },
            "typed_error_required": {
              "type": "boolean"
            },
            "failure_kinds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^OPERATION_FAILURE_KIND_[A-Z0-9_]+$"
              }
            }
          }
        }
      }
    }
  }
}
