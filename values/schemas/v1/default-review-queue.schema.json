{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spatialanalyzer.github.io/briosa/values/schemas/v1/default-review-queue.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "spatial_analyzer_target", "conflict_policy", "objective_sa", "summary", "entries"],
  "properties": {
    "$schema": { "const": "../../../../values/schemas/v1/default-review-queue.schema.json" },
    "schema_version": { "const": 1 },
    "spatial_analyzer_target": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){3}$" },
    "conflict_policy": { "type": "string", "minLength": 1 },
    "objective_sa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_url", "commit", "declared_version", "source_layout", "sha256"],
      "properties": {
        "repository_url": { "const": "https://github.com/spatialanalyzer/ObjectiveSA" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "declared_version": { "type": "string", "minLength": 1 },
        "source_layout": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corroborated_default_count", "reviewed_no_default_count", "needs_review_count", "no_candidate_count"],
      "properties": {
        "corroborated_default_count": { "type": "integer", "minimum": 0 },
        "reviewed_no_default_count": { "type": "integer", "minimum": 0 },
        "needs_review_count": { "type": "integer", "minimum": 0 },
        "no_candidate_count": { "type": "integer", "minimum": 0 }
      }
    },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["inventory_key", "mp_step", "argument_ordinal", "sdk_order", "mp_name", "setter", "candidates"],
        "properties": {
          "inventory_key": { "type": "string", "minLength": 1 },
          "mp_step": { "type": "string", "minLength": 1 },
          "argument_ordinal": { "type": ["integer", "null"], "minimum": 0 },
          "sdk_order": { "type": "integer", "minimum": 0 },
          "mp_name": { "type": "string", "minLength": 1 },
          "setter": { "type": "string", "pattern": "^Set[A-Za-z0-9]+Arg[0-9]*$" },
          "candidates": { "type": "array", "minItems": 1 }
        }
      }
    }
  }
}
